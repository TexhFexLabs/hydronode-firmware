    {
      "id": "ds18b20",
      "name": "DS18B20",
      "summary": "Waterproof temperature probe, several on one pin",
      "category": "temperature",
      "bus": "onewire",
      "maxPerBus": 8,
      "pins": [
        {
          "key": "pin",
          "label": "Data (DQ)",
          "caps": [
            "digital"
          ],
          "pullup": "4.7 kΩ between DQ and 3.3 V"
        }
      ],
      "channels": [
        {
          "q": "t",
          "defaultType": "TEMPERATURE",
          "typeOptions": [
            "TEMPERATURE",
            "WATER_TEMPERATURE",
            "SOIL_TEMPERATURE"
          ]
        }
      ],
      "options": [],
      "warmupMs": 750,
      "sleepSafe": true,
      "wiring": "Red to 3.3 V, black to GND, yellow to the data pin. 4.7 kΩ between yellow and 3.3 V.",
      "libs": [
        "OneWireNg",
        "DallasTemperature"
      ],
      "esphome": "dallas_temp"
    },
